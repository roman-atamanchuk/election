<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.AddPoliticianController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Add Politician" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TextField fx:id="idField" promptText="ID (e.g. P10)"/>
    <TextField fx:id="nameField" promptText="Name"/>
    <TextField fx:id="dobField" promptText="Date of Birth (YYYY-MM-DD)"/>
    <TextField fx:id="partyField" promptText="Party"/>
    <TextField fx:id="countyField" promptText="County"/>
    <TextField fx:id="imageField" promptText="Image URL"/>

    <HBox spacing="10">
        <Button text="Save" onAction="#onSave"/>
        <Button text="Cancel" onAction="#onCancel"/>
    </HBox>

</VBox>
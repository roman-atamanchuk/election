<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.AddElectionController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Add / Edit Election"/>

    <TextField fx:id="idField" promptText="Election ID"/>

    <!-- 🔹 FIXED -->
    <ChoiceBox fx:id="typeBox"/>

    <TextField fx:id="yearField" promptText="Year"/>
    <TextField fx:id="locationField" promptText="Location"/>
    <TextField fx:id="seatsField" promptText="Seats"/>

    <HBox spacing="10">
        <Button text="Save" onAction="#onSave"/>
        <Button text="Cancel" onAction="#onCancel"/>
    </HBox>

</VBox>